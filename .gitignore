# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# MLflow
mlartifacts/
mlruns/
*.db

# Generated reports and figures (so we don't commit auto-generated graphs)
reports/figures/
*.png
*.jpg
*.jpeg
*.pdf
*.svg
models/demo_best/**/*.pth
!models/demo_best/classification/cwru_classifier.pth
!models/demo_best/rul/xjtu_rul.pth

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
*:Zone.Identifier

# Other potential temp files
tmp/
temp/
*.log

# Training/debug artifacts that are unnecessary for clean git releases
/data
/reports
/catboost_info/
/models/preds_*/
